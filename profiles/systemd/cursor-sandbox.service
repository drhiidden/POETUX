[Unit]
Description=Cursor Editor (Sandboxed with Firejail + AppArmor)
Documentation=https://cursor.sh
After=network.target

# FILOSOFÍA SYSTEMD HARDENING:
# "Defense in depth through service isolation"
# Systemd proporciona capa adicional de sandboxing a nivel de init system

[Service]
Type=simple
ExecStart=/usr/bin/firejail --profile=/etc/firejail/cursor.profile /usr/bin/cursor --no-sandbox %F

# === PROCESS ISOLATION ===
# Systemd namespace isolation (complementa Firejail)

# NoNewPrivileges: CRÍTICO
# Previene escalada de privilegios vía setuid/setgid
# Kernel: prctl(PR_SET_NO_NEW_PRIVS, 1)
NoNewPrivileges=yes

# PrivateTmp: Aislamiento de /tmp
# Cada instancia del servicio ve su propio /tmp
# Kernel: mount namespace con tmpfs privado
PrivateTmp=yes

# === FILESYSTEM PROTECTION ===

# ProtectSystem: Sistema de archivos read-only
# strict = TODO read-only excepto /dev, /proc, /sys
# full = /usr, /boot, /etc read-only
# Kernel: mount namespace con bind mounts read-only
ProtectSystem=full

# ProtectHome: Ocultar home directories
# yes = /home, /root, /run/user read-only
# tmpfs = montaje tmpfs vacío
# read-only = acceso solo lectura
# Kernel: mount namespace
# NOTA: Firejail ya maneja esto, pero defensa en profundidad
ProtectHome=read-only

# ReadWritePaths: Excepciones para write access
# Necesario para Cursor config y projects
ReadWritePaths=/home/%u/.config/Cursor /home/%u/.cursor /home/%u/Projects /home/%u/workspace

# ProtectKernelTunables: /proc/sys, /sys read-only
# Previene modificación de parámetros del kernel
ProtectKernelTunables=yes

# ProtectKernelModules: Previene carga de módulos
# Kernel: capability CAP_SYS_MODULE dropped
ProtectKernelModules=yes

# ProtectControlGroups: /sys/fs/cgroup read-only
# Previene escape via cgroups
ProtectControlGroups=yes

# === NETWORK RESTRICTIONS ===

# RestrictAddressFamilies: Limitar address families
# Solo permitir lo necesario para networking
# Kernel: seccomp filter para socket()
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# IPAddressAllow/Deny: Filtrado por IP (opcional)
# IPAddressDeny=any
# IPAddressAllow=localhost
# IPAddressAllow=192.168.0.0/16

# === CAPABILITY RESTRICTIONS ===

# CapabilityBoundingSet: Limitar capabilities
# empty = sin capabilities (ideal)
# Kernel: prctl(PR_CAPBSET_DROP)
CapabilityBoundingSet=

# AmbientCapabilities: Capabilities heredadas
# empty = no heredar capabilities
AmbientCapabilities=

# === SYSTEM CALL FILTERING ===

# SystemCallFilter: Seccomp whitelist
# @system-service = syscalls comunes para servicios
# Kernel: seccomp-bpf
SystemCallFilter=@system-service @file-system @network-io @io-event @signal @ipc
SystemCallFilter=~@privileged @resources @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap

# SystemCallArchitectures: Arquitecturas permitidas
# Previene execution de código para otras arquitecturas
SystemCallArchitectures=native

# SystemCallErrorNumber: Error al bloquear syscall
# EPERM = Operation not permitted
SystemCallErrorNumber=EPERM

# === MEMORY PROTECTION ===

# MemoryDenyWriteExecute: W^X policy
# Previene páginas de memoria RWX (Write + Execute)
# Mitiga ROP attacks y JIT exploits
# Kernel: mmap/mprotect restrictions
MemoryDenyWriteExecute=yes

# LockPersonality: Previene cambio de execution domain
# Mitiga ataques que cambian personality del proceso
# Kernel: personality() syscall bloqueado
LockPersonality=yes

# === DEVICE RESTRICTIONS ===

# PrivateDevices: /dev limitado
# Solo dispositivos pseudo (null, zero, random)
# Kernel: mount namespace con devtmpfs filtrado
PrivateDevices=yes

# DevicePolicy: Política de acceso a dispositivos
# closed = deny by default
# strict = whitelist explicit
DevicePolicy=closed

# DeviceAllow: Whitelist de dispositivos (si PrivateDevices=no)
# /dev/null rw
# /dev/urandom r
# /dev/dri/* rw (para GPU si se necesita)

# === RESTRICCIONES ADICIONALES ===

# RestrictNamespaces: Limitar creación de namespaces
# Previene escape via user namespaces
# Kernel: CLONE_NEW* flags en clone/unshare
RestrictNamespaces=yes

# RestrictRealtime: Bloquear realtime scheduling
# Previene DoS via RT priority
# Kernel: sched_setscheduler restrictions
RestrictRealtime=yes

# RestrictSUIDSGID: Ignorar setuid/setgid bits
# Previene escalada via binarios setuid
# Kernel: mount option nosuid
RestrictSUIDSGID=yes

# RemoveIPC: Limpiar IPC al terminar
# Previene leak de objetos IPC
# Kernel: cleanup de SysV IPC, POSIX mqueues, SHM
RemoveIPC=yes

# === UMASK ===

# UMask: Permisos por defecto para archivos creados
# 0077 = solo owner puede acceder
UMask=0077

# === RESOURCE LIMITS ===

# LimitNOFILE: Máximo file descriptors
# Previene DoS via FD exhaustion
LimitNOFILE=1024

# LimitNPROC: Máximo procesos
# Previene fork bomb
LimitNPROC=512

# === ENVIRONMENT ===

# Environment: Variables de entorno seguras
Environment="PATH=/usr/local/bin:/usr/bin"

# === LOGGING ===

# StandardOutput/Error: Logging
StandardOutput=journal
StandardError=journal

# SyslogIdentifier: Tag en syslog
SyslogIdentifier=cursor-sandbox

[Install]
WantedBy=default.target

################################################################################
# ARQUITECTURA DE DEFENSA EN PROFUNDIDAD:
#
# CAPA 1 - SYSTEMD (esta unidad):
#   ✓ NoNewPrivileges
#   ✓ ProtectSystem=full
#   ✓ ProtectHome=read-only
#   ✓ PrivateTmp, PrivateDevices
#   ✓ SystemCallFilter (seccomp-bpf)
#   ✓ MemoryDenyWriteExecute
#   ✓ Capabilities dropped
#
# CAPA 2 - FIREJAIL:
#   ✓ Namespace isolation
#   ✓ Filesystem whitelist
#   ✓ Seccomp additional filters
#   ✓ No capabilities
#
# CAPA 3 - APPARMOR:
#   ✓ Mandatory Access Control
#   ✓ Path-based restrictions
#
# KERNEL SUBSYSTEMS UTILIZADOS:
# 1. Namespaces (PID, NET, MNT, IPC, UTS, CGROUP, USER)
# 2. Seccomp-BPF (syscall filtering)
# 3. Capabilities (privilegios granulares)
# 4. LSM (Linux Security Modules) - AppArmor
# 5. cgroups (resource limits)
# 6. mount options (nosuid, nodev, noexec)
#
# SURFACE DE ATAQUE MINIMIZADA:
# - ✓ No syscalls privilegiadas
# - ✓ No capabilities
# - ✓ No acceso a dispositivos físicos
# - ✓ No creación de namespaces
# - ✓ No realtime scheduling
# - ✓ No setuid/setgid
# - ✓ Memory protections activas
# - ✓ Filesystem read-only excepto config
#
# INSTALACIÓN:
# 1. Copiar a: ~/.config/systemd/user/cursor-sandbox.service
# 2. Recargar: systemctl --user daemon-reload
# 3. Habilitar: systemctl --user enable cursor-sandbox.service
# 4. Iniciar: systemctl --user start cursor-sandbox.service
#
# VERIFICACIÓN:
# $ systemctl --user status cursor-sandbox
# $ journalctl --user -u cursor-sandbox -f
# $ systemd-analyze --user security cursor-sandbox
#
# SYSTEMD-ANALYZE SECURITY:
# Esta herramienta audita el nivel de sandboxing:
# - EXPOSURE: 0.1 (excelente) - 10.0 (pésimo)
# - Objetivo: < 2.0
#
# TRADE-OFFS:
# - ProtectHome=read-only (no tmpfs): Cursor necesita acceso a Projects
# - RestrictAddressFamilies permite networking: Cursor necesita red
# - MemoryDenyWriteExecute: Puede romper JIT de Electron (probar)
#
# WHAT LINUS WOULD SAY:
# ✓ "Good: Each option has clear kernel backing"
# ✓ "Good: No cargo-cult security (cada opción justificada)"
# ✓ "Good: Trade-offs documentados"
# ✗ "Electron is bloat, but if you must use it, at least cage it properly"
#
# REGRESSION TEST:
# - ✓ Cursor inicia correctamente
# - ✓ Puede abrir proyectos
# - ✓ Puede guardar archivos
# - ✓ Terminal integrada funciona
# - ✓ Extensions funcionan
# - ✓ NO puede acceder a ~/.ssh
# - ✓ NO puede escalar privilegios
# - ✓ NO puede cargar módulos kernel
################################################################################

